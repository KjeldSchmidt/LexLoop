DB_URL=postgresql+psycopg://user:password@localhost:5435/lexloopdb
LOCAL_TEST_DB_URL=postgresql+psycopg://user:password@localhost:5436/lexloopdb_test

# Auth (required for real login; defaults exist for local bootstrapping only)
# Deployed envs load JWT + Google OAuth from Secrets Manager (AUTH_SECRETS_ARN).
JWT_SIGNING_SECRET=replace-me
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Absolute callback for Google console + fastapi-users (required for local OAuth)
GOOGLE_OAUTH_REDIRECT_URL=http://127.0.0.1:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
